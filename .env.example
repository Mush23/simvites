# ─────────────────────────────────────────────────────────────
# Milestones environment variables — copy to .env.local and fill in.
# Never commit .env.local. All NEXT_PUBLIC_* values are exposed to
# the browser; everything else stays server-only.
# ─────────────────────────────────────────────────────────────

# --- App / multi-tenant routing ---
# The apex marketing domain (no protocol). Locally we use a lvh.me trick so
# subdomains resolve to 127.0.0.1 — e.g. http://demo.lvh.me:3000
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000
# The address shown to couples in Settings ("<slug>.<domain>").
#
# ⚠ THE PRODUCTION DOMAIN IS NOT CHOSEN YET. The fallback in lib/brand.ts is
# still simvites.co.uk, which was never registered by anyone — set both of these
# explicitly in production rather than relying on that default.
NEXT_PUBLIC_BASE_DOMAIN=your-domain.example

# --- REQUIRED: guest token pepper (server-only) ---
# Guest invite tokens are stored as sha256(TOKEN_PEPPER + raw). lib/tokens.ts
# THROWS if this is unset, so the first invite link generated will fail —
# generate one before the first deploy and never rotate it without
# invalidating every outstanding invite link.
#   openssl rand -base64 32
TOKEN_PEPPER=

# --- Supabase (DB + Storage + Auth + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used by trusted server actions / jobs only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres connection string (Session/Transaction pooler URI, password included).
# Used by the db:apply / db:verify scripts to run migrations. Server-only.
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Stripe (billing) ---
# No Products or Prices need creating in the Stripe dashboard: checkout builds
# the line item inline from lib/pricing.ts. There is deliberately no publishable
# key here — checkout is a server-side redirect, not Stripe.js, so nothing in
# this codebase ever reads one.
STRIPE_SECRET_KEY=sk_test_xxx
# REQUIRED IN PRODUCTION. Without it /api/stripe/webhook returns 503 instead of
# trusting unsigned payloads — an unsigned checkout.session.completed carrying a
# site_id would otherwise unlock a site for free.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- REQUIRED: guest session secret (server-only) ---
# HMAC secret for the HttpOnly guest cookie. lib/guest-session.ts THROWS if this
# is unset — it does NOT fall back to the service-role key, whatever this file
# used to say. Like TOKEN_PEPPER, changing it after launch invalidates every
# live guest session.
#   openssl rand -base64 32
GUEST_SESSION_SECRET=

# --- Resend (guest invitation emails) ---
# Also doubles as Supabase's custom SMTP provider, which is what makes LOGIN
# work: Supabase's built-in sender is capped at 2 messages/hour and is not for
# production. Same key, configured in the Supabase dashboard. See docs/DEPLOY.md.
RESEND_API_KEY=re_xxx
RESEND_FROM=Milestones <invitations@yourdomain>

# Platform admin allowlist (comma-separated emails)
PLATFORM_ADMIN_EMAILS=you@example.com

# --- Anthropic (AI guest import + planning assistant) — optional/guarded ---
# Get a key at console.anthropic.com → API Keys. Without it, import falls back
# to the column parser and the Assistant shows a "connect AI" state.
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Twilio (two-way SMS + WhatsApp guest messaging) — optional/guarded ---
# Console → Account SID + Auth Token; buy an SMS number; enable WhatsApp sender.
# Point the number's inbound webhook to /api/webhooks/twilio (POST).
# TWILIO_AUTH_TOKEN also signs inbound webhooks: in production the webhook
# REJECTS everything without it, so forged messages cannot reach an inbox.
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_SMS_FROM=+447700900000
TWILIO_WHATSAPP_FROM=+447700900000

# --- Photo search (editor image fields) — optional ---
# Without it, search falls back to Openverse (keyless, CC-licensed).
UNSPLASH_ACCESS_KEY=

# --- PostHog (funnel analytics) — optional ---
# No-ops entirely until the key is set; without it the launch funnel is blind.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Cron (daily payment reminders on Vercel) ---
# REQUIRED IN PRODUCTION. Gates /api/cron/*; Vercel Cron sends it automatically
# once set. Without it the route returns 503 rather than running unauthenticated.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Planned, but NOT READ BY ANY CODE YET. Setting these has no
# effect today. Kept so the intent is recorded rather than lost,
# and listed here so nobody sets one and expects a behaviour.
#
#   VERCEL_API_TOKEN     ┐ per-couple custom domains via the
#   VERCEL_PROJECT_ID    │ Vercel Domains API — feature not built
#   VERCEL_TEAM_ID       ┘
#   RESEND_WEBHOOK_SECRET  delivery/bounce webhook — no route exists.
#                          The only inbound webhooks served are
#                          /api/stripe/webhook and /api/webhooks/twilio.
# ─────────────────────────────────────────────────────────────
