# ─────────────────────────────────────────────────────────────
# Simvites environment variables — copy to .env.local and fill in.
# Never commit .env.local. All NEXT_PUBLIC_* values are exposed to
# the browser; everything else stays server-only.
# ─────────────────────────────────────────────────────────────

# --- App / multi-tenant routing ---
# The apex marketing domain (no protocol). Locally we use a lvh.me trick so
# subdomains resolve to 127.0.0.1 — e.g. http://demo.lvh.me:3000
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000
# In production this becomes: simvites.co.uk

# --- Supabase (DB + Storage + Auth + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used by trusted server actions / jobs only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres connection string (Session/Transaction pooler URI, password included).
# Used by the db:apply / db:verify scripts to run migrations. Server-only.
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Guest sessions (HMAC secret for the HttpOnly guest cookie) ---
# Defaults to the service-role key if unset; set a dedicated secret in prod.
GUEST_SESSION_SECRET=

# --- Resend (invite + RSVP emails) ---
RESEND_API_KEY=re_xxx
RESEND_FROM=Simvites <invitations@yourdomain>
RESEND_WEBHOOK_SECRET=

# --- Vercel Domains API (custom-domain add-on) — later sprint ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
