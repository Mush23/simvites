{
  "name": "simvites",
  "version": "0.1.0",
  "private": true,
  "description": "Simvites — multi-tenant event-website builder (South Asian wedding wedge)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=36",
    "typecheck": "tsc --noEmit",
    "db:apply": "node --env-file=.env.local scripts/db-apply.mjs",
    "db:verify": "node --env-file=.env.local scripts/db-verify.mjs",
    "user:create": "node --env-file=.env.local scripts/create-test-user.mjs",
    "test:isolation": "node --env-file-if-exists=.env.local scripts/isolation-test.mjs",
    "test:rsvp": "node --env-file-if-exists=.env.local scripts/test-rsvp.mjs",
    "test:all": "npm run test:isolation && npm run test:rsvp",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@puckeditor/core": "^0.21.3",
    "@stripe/stripe-js": "^5.6.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.23.0",
    "next": "^16.2.7",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "22.10.7",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.1",
    "tailwindcss": "^4.3.0",
    "typescript": "5.7.3"
  }
}
